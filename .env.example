# Copy this file to .env (`cp .env.example .env`). .env is never committed.

DATABASE_URL="file:./dev.db"
# Private passwords for this dashboard's own APIs - any long random strings.
CAPTURE_API_TOKEN="generate-a-long-random-token"
OPS_API_TOKEN="generate-a-separate-long-random-token"
# The dashboard listens on 127.0.0.1 only. If you expose it (e.g. over
# Tailscale), set this to true to require a login: user `g2`, password
# OPS_API_TOKEN.
DASHBOARD_AUTH_ENABLED="false"

# Python for the agent scripts. Leave empty to use `python` from PATH - on
# Windows, make sure that resolves to a real install and not the Microsoft
# Store stub, which does not run reliably from Task Scheduler.
SECONDBRAIN_PYTHON=""
# Local model for private-content triage (needs Ollama).
SECONDBRAIN_LOCAL_MODEL="qwen3:8b"

# LabSerf bench (Research -> Lab notebook). LABSERF_PYTHON is the interpreter
# with the packages in labserf/requirements.txt (e.g. a conda env's
# python.exe); empty = SECONDBRAIN_PYTHON / `python`. LABSERF_ROOT points at a
# LabSerf checkout other than the bundled labserf/ folder.
LABSERF_PYTHON=""
# LABSERF_ROOT=""

# Background reasoning model (flush, guardrail, heartbeat, reflection, drafting).
# Sonnet by default; set to "haiku" for cheaper/faster, or a full model id.
SECONDBRAIN_MODEL=sonnet

# Optional: Anthropic API key. The background scripts run through the Claude
# CLI on your subscription and do not need a key.
# ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Heartbeat active hours default to your work blocks in
# .claude/agents/day-schedule.json; set these only to override them.
# HEARTBEAT_ACTIVE_HOURS_START=9
# HEARTBEAT_ACTIVE_HOURS_END=20

# Backup routing when a subscription window runs out: opus -> sonnet inside
# Claude, then claude <-> codex across providers. Private jobs never leave the
# local runtime either way. Set to 1 to make every runtime fail fast instead.
# SECONDBRAIN_DISABLE_FAILOVER=1
